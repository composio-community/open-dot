{
  "name": "open-dot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "desktop:dev": "electron electron --dev",
    "desktop:prepare": "next build && node scripts/desktop-prepare.mjs",
    "desktop": "electron electron",
    "desktop:build": "npm run desktop:prepare && npm exec --yes --package=pnpm@12.5.1 -- pnpm exec electron-builder",
    "desktop:build:win": "npm run desktop:prepare && npm exec --yes --package=pnpm@12.5.1 -- pnpm exec electron-builder --win zip nsis --x64",
    "test:windows": "node scripts/check-windows.mjs",
    "test:desktop:win": "node scripts/check-desktop.mjs --packaged",
    "test:security:win": "node scripts/check-origin-security.mjs --packaged",
    "test:userflows:win": "node scripts/check-userflows.mjs --packaged",
    "test:approvals": "node scripts/check-approvals.mjs",
    "test:logins:win": "node scripts/check-login-security.mjs",
    "test:routers": "node scripts/check-routers.mjs",
    "test:tool-history": "node scripts/check-tool-history.mjs",
    "test:installer:win": "node scripts/check-install-windows.mjs"
  },
  "dependencies": {
    "@composio/core": "0.22.0",
    "@e2b/desktop": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "croner": "^10.0.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1",
  "build": {
    "appId": "dev.composio.opendot",
    "productName": "Open Dot",
    "electronVersion": "44.4.5",
    "directories": {
      "app": "electron",
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": ".desktop/server",
        "to": "server"
      },
      {
        "from": ".desktop/browser",
        "to": "browser"
      },
      {
        "from": ".desktop/notices",
        "to": "notices"
      },
      {
        "from": "START-HERE.md",
        "to": "START-HERE.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "PUBLIC-RELEASE-STATUS.md",
        "to": "PUBLIC-RELEASE-STATUS.md"
      }
    ],
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }, { "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Open Dot uses the microphone for voice mode."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "files": [
      "main.mjs",
      "icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/desktop-after-pack.mjs"
  }
}
