{
  "name": "open-dot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "desktop:dev": "OPEN_DOT_DEV_URL=http://localhost:3100 electron electron",
    "desktop:prepare": "next build && node scripts/desktop-prepare.mjs",
    "desktop": "electron electron",
    "desktop:build": "pnpm desktop:prepare && electron-builder --mac"
  },
  "dependencies": {
    "@composio/core": "0.22.0",
    "@e2b/desktop": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "croner": "^10.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1",
  "build": {
    "appId": "dev.composio.opendot",
    "productName": "Open Dot",
    "electronVersion": "44.4.5",
    "directories": {
      "app": "electron",
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": ".desktop/server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Open Dot uses the microphone for voice mode."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "files": [
      "main.mjs",
      "package.json",
      "!**/node_modules/**"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/desktop-after-pack.mjs"
  }
}
